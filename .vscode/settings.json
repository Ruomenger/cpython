{
    "files.exclude": {
        "**/*.o": true,
        "**/*.pyc": true,
        "**/__pycache__": true,
        "build/": true
    },
    "search.exclude": {
        "build/": true,
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "pyconfig.h.in": "c",
        "Modules/Setup*": "python",
        "Makefile.pre": "makefile",
        "Makefile.pre.in": "makefile"
    },
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "clangd.path": "clangd",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build/debug",
        "--header-insertion=never",
        "--background-index",
        "--clang-tidy",
        "--all-scopes-completion",
        "--completion-style=detailed"
    ]
}
