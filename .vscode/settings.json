{
    "files.exclude": {
        "**/*.o": true,
        "**/*.pyc": true,
        "**/__pycache__": true,
        "build": true
    },
    "search.exclude": {
        "build": true,
        "**/__pycache__": true,
        "**/*.pyc": true
    },
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "pyconfig.h.in": "c",
        "Modules/Setup*": "python",
        "Makefile.pre": "makefile",
        "Makefile.pre.in": "makefile"
    },
    // 用 clangd 做 C 索引；禁用 MS C/C++ 扩展的 IntelliSense 以免双引擎冲突。
    "C_Cpp.intelliSenseEngine": "disabled",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "clangd.path": "/opt/homebrew/opt/llvm/bin/clangd",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/build",
        "--enable-config",
        "--query-driver=/opt/homebrew/opt/llvm/bin/clang++,/opt/homebrew/opt/llvm/bin/clang,/usr/bin/gcc,/usr/bin/g++",
        "--all-scopes-completion",
        "--background-index",
        "--clang-tidy",
        "--completion-parse=auto",
        "--completion-style=bundled",
        "--function-arg-placeholders",
        "--header-insertion-decorators",
        "--header-insertion=iwyu",
        "--limit-references=1000",
        "--limit-results=300",
        "--pch-storage=memory"
    ]
}
