{
    // 说明：项目主力用 clangd 做索引（见 settings.json）。
    // 本文件仅在启用 Microsoft C/C++ 扩展的 IntelliSense 时才会被使用，保留作备用/参考。
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/Include",
                "${workspaceFolder}/Include/internal"
            ],
            "defines": [
                "Py_DEBUG",
                "Py_REF_DEBUG",
                "Py_BUILD_CORE"
            ],
            "compilerPath": "/opt/homebrew/opt/llvm/bin/clang",
            "cStandard": "c11",
            "intelliSenseMode": "macos-clang-arm64",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}
